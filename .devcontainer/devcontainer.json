{
    "name": "Security Hub",

    // Nutzt die normale compose.yaml und ergänzt einen Entwicklungs-Container
    "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
    "service": "dev",
    "workspaceFolder": "/workspaces/security-hub",

    // Postgres und Airflow laufen mit, das Backend startest du selbst im
    // Devcontainer (mit Auto-Reload), siehe postAttachCommand-Hinweis
    "runServices": ["dev", "postgres", "airflow"],
    "shutdownAction": "stopCompose",

    "features": {
        // Docker-Befehle im Container nutzen den Docker des Hosts
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "helm": "none",
            "minikube": "none"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "postCreateCommand": "pip install --user -r requirements.txt -r airflow/requirements.txt",
    "postAttachCommand": "echo 'Backend starten: uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000  |  Tests: pytest'",

    "forwardPorts": [8000, "airflow:8080"],
    "portsAttributes": {
        "8000": { "label": "Security Hub (Backend)", "onAutoForward": "openBrowser" },
        "airflow:8080": { "label": "Airflow" }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "ms-azuretools.vscode-containers",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "github.vscode-github-actions",
                "redhat.vscode-yaml",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["tests"],
                "sqltools.connections": [
                    {
                        "name": "Security Hub DB",
                        "driver": "PostgreSQL",
                        "server": "postgres",
                        "port": 5432,
                        "database": "securityhub",
                        "username": "securityhub",
                        "password": "securityhub"
                    }
                ]
            }
        }
    }
}
