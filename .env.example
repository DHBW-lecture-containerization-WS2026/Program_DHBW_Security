# Kopieren nach .env und bei Bedarf anpassen. Alle Werte sind optional.

# URL-Checker (https://developers.google.com/safe-browsing)
GOOGLE_SAFE_BROWSING_API_KEY=

# Schnellerer NVD-Abruf (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Datenbank
POSTGRES_USER=securityhub
POSTGRES_PASSWORD=securityhub

# Wie viele Tage Daten aufbewahrt werden
SECURITY_HUB_RETENTION_DAYS=30

# Airflow-Oberfläche, falls Port 8080 schon belegt ist
AIRFLOW_PORT=8080

# Airflow (für alles außer lokale Entwicklung ändern)
AIRFLOW_JWT_SECRET=local-dev-secret-change-me
